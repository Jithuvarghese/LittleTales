{
  "name": "littletales",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bash scripts/check-clean.sh dist",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "check:clean": "bash scripts/check-clean.sh",
    "prepare": "husky",
    "content:manifest": "tsx scripts/build-manifest.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:convert": "tsx scripts/md-to-story.ts",
    "content:new-story": "tsx scripts/new-story.ts",
    "predev": "npm run content:manifest",
    "prebuild": "npm run content:manifest && npm run content:validate",
    "audio:generate": "tsx scripts/tts/generate.ts",
    "audio:samples": "tsx scripts/tts/generate.ts --samples",
    "audio:review": "tsx scripts/tts/review.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "audio:export-lines": "tsx scripts/tts/export-lines.ts",
    "audio:import": "tsx scripts/tts/import-clips.ts",
    "audio:bakeoff": "tsx scripts/tts/bakeoff.ts",
    "audio:estimate": "tsx scripts/tts/generate.ts --estimate",
    "audio:ab": "tsx scripts/tts/ab.ts",
    "audio:polish": "tsx scripts/tts/polish.ts",
    "content:preview": "tsx scripts/preview.ts"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "framer-motion": "^14.2.0",
    "howler": "^2.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
